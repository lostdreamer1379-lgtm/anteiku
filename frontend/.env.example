# Supabase project (public values only — never put service-role keys in frontend env)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL
VITE_API_BASE_URL=http://localhost:4000/api

# Playback provider: "demo" (sample clips) or "vidrift" (AniList iframe embed).
# VidRift currently documents a no-key embed; use it only for content you are authorised to stream.
VITE_PLAYBACK_PROVIDER=demo
